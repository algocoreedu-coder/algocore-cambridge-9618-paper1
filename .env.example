# Copy this file to .env.local and replace every placeholder.
ALGOCORE_STUDENT_USERNAME=replace-with-student-username
ALGOCORE_STUDENT_PASSWORD=replace-with-strong-password
ALGOCORE_SESSION_SECRET=replace-with-at-least-32-random-bytes
ALGOCORE_COOKIE_SECURE=true
# Opt-in local/demo access without a student account. Keep false in production.
ALGOCORE_PUBLIC_PREVIEW=false
